# ── Database ──────────────────────────────────────────────
POSTGRES_USER=sentinelpay
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinelpay
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Composed URL (used by the app and Alembic; auto-resolves 'db' in Docker vs 'localhost' on host OS)
DATABASE_URL=postgresql+psycopg://sentinelpay:changeme@localhost:5432/sentinelpay


# ── App ───────────────────────────────────────────────────
APP_NAME=SentinelPay
DEBUG=true

# ── Security & JWT ─────────────────────────────────────────
JWT_SECRET_KEY=sentinelpay_super_secret_jwt_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Transaction Limits ─────────────────────────────────────
SINGLE_TRANSFER_LIMIT=5000.00
DAILY_TRANSFER_LIMIT=10000.00

# ── Fraud Engine Config ────────────────────────────────────
FRAUD_LARGE_AMOUNT_THRESHOLD=2000.00
FRAUD_LARGE_AMOUNT_POINTS=40
FRAUD_HIGH_VELOCITY_COUNT=3
FRAUD_HIGH_VELOCITY_POINTS=35
FRAUD_NEW_RECIPIENT_THRESHOLD=500.00
FRAUD_NEW_RECIPIENT_POINTS=30
FRAUD_NEAR_LIMIT_PERCENT=0.90
FRAUD_NEAR_LIMIT_POINTS=25
FRAUD_NEW_ACCOUNT_DAYS=30
FRAUD_NEW_ACCOUNT_POINTS=20

# ── Environment & Security Hardening (Phase 10) ───────────────
ENVIRONMENT=development
DOCS_ENABLED=true

# Set RATE_LIMIT_ENABLED=false during dev & UI testing to avoid 429s during demos
RATE_LIMIT_ENABLED=false

# CORS Allowed Origins (comma-separated or list) for local frontend dev servers
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
